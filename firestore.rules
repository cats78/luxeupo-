rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    // Products collection: public read and authorized updates
    // Synced in real-time across all devices
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories & subcategories collection: public read and admin sync
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Banners collection: homepage auto-sliding carousel
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings collection: branding, logo, contact, future payment configs
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders collection:
    // Anyone can create an order with contact & item details.
    // Real-time access for showroom fulfillment.
    match /orders/{orderId} {
      allow create: if incoming().customerName is string &&
                       incoming().customerName.size() > 0 &&
                       incoming().customerPhone is string &&
                       incoming().customerPhone.size() >= 7;
      allow read, update, delete: if true;
    }

    // Enquiries collection:
    // Customer consultations and support requests saving name, phone number, and message.
    // Real-time notifications for admin suite.
    match /enquiries/{enquiryId} {
      allow create: if incoming().customerName is string &&
                       incoming().customerName.size() > 0 &&
                       incoming().customerPhone is string &&
                       incoming().customerPhone.size() >= 7 &&
                       incoming().message is string &&
                       incoming().message.size() > 0;
      allow read, update, delete: if true;
    }

    // Admins collection: managed by system
    match /admins/{adminUid} {
      allow read, write: if true;
    }
  }
}
